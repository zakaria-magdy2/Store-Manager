{
  "name": "@retailos/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/index.d.ts",
  "description": "RetailOS Electron Desktop Application",
  "author": "RetailOS",
  "scripts": {
    "build": "tsc -b && node scripts/build-preload.mjs",
    "clean": "node -e \"import('node:fs/promises').then(async fs => { for (const p of ['dist','stage','release','tsconfig.tsbuildinfo']) await fs.rm(p, { recursive: true, force: true }); })\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "tsc -b && node scripts/build-preload.mjs && node --test tests/*.test.mjs",
    "desktop:dev": "pnpm run desktop:build && electron .",
    "desktop:build": "pnpm --filter @retailos/web... build && pnpm run build && node scripts/stage-web-runtime.mjs",
    "desktop:pack:win": "pnpm run desktop:build && electron-builder --win --dir --config electron-builder.json",
    "desktop:dist:win": "pnpm run desktop:build && electron-builder --win --config electron-builder.json"
  },
  "dependencies": {
    "@retailos/application": "workspace:*",
    "@retailos/core": "workspace:*",
    "@retailos/infrastructure": "workspace:*",
    "@retailos/shared": "workspace:*"
  },
  "devDependencies": {
    "@retailos/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  }
}
