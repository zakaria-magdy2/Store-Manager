{
  "name": "@retailos/web",
  "version": "0.1.0",
  "private": true,
  "description": "RetailOS Web Client Application",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build": "node build.mjs",
    "lint": "node --check server.mjs && node --check public/app.js && node --check build.mjs && pnpm exec eslint server.mjs build.mjs public/app.js tests/*.test.mjs tests/*.spec.mjs --max-warnings 0",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test -c playwright.config.mjs"
  },
  "dependencies": {
    "@retailos/application": "workspace:*",
    "@retailos/core": "workspace:*",
    "@retailos/infrastructure": "workspace:*",
    "@retailos/shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
