{
  "name": "retailos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Universal Retail Management System",
  "packageManager": "pnpm@12.21.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --concurrency=1",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "desktop:dev": "pnpm --filter @retailos/desktop desktop:dev",
    "desktop:build": "pnpm --filter @retailos/desktop desktop:build",
    "desktop:pack:win": "pnpm --filter @retailos/desktop desktop:pack:win",
    "desktop:dist:win": "node -e \"import('node:child_process').then(({spawnSync})=>{const w=process.platform==='win32';const r=spawnSync(w?'cmd.exe':'pnpm',w?['/d','/s','/c','pnpm','--filter','@retailos/desktop','desktop:dist:win']:['--filter','@retailos/desktop','desktop:dist:win'],{stdio:'inherit',env:{...process.env,RETAILOS_REQUIRE_SIGNED_MANIFEST:'1'}});process.exit(r.status??1);})\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
